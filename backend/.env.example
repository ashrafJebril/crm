# Local development environment for CRM with local PostgreSQL

# ── Database (existing local PostgreSQL on 5440) ────────────────────────────
DATABASE_URL="postgresql://aram:aram@localhost:5440/aram"

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4100
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ── JWT Secrets ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod

# ── HJZ SSO Bridge (disabled locally) ───────────────────────────────────────
AUTH_MODE=sso
HJZ_JWT_ACCESS_SECRET=
HJZ_WEBHOOK_SECRET=
# HJZ two-way sync. A workspace is "connected" when its externalTenantId is set
# (SSO / client webhooks set it). With HJZ_API_URL + HJZ_WEBHOOK_SECRET set, new
# CRM contacts are created as HJZ clients and CRM segments/groups are mirrored
# to HJZ. HJZ_WEBHOOK_SECRET must equal HJZ's MARKETING_WEBHOOK_SECRET.
# (Legacy: HJZ_OUTBOUND_URL=<base>/webhooks/marketing/segments still works.)
HJZ_API_URL=http://127.0.0.1:3030/api/v1
# HJZ web app origin. Enables "Open HJZ" (CRM → HJZ without a second login),
# and connected bookings are mirrored to HJZ appointments via HJZ_API_URL.
HJZ_WEB_URL=http://localhost:5173

# ── Public URLs (local) ────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:4100
BACKEND_PUBLIC_URL=http://localhost:4100
FRONTEND_PUBLIC_URL=http://localhost:5174

# ── API Keys (empty for local, can add if needed) ─────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
OPENAI_API_KEY=

# ── Meta / WhatsApp (local stubs) ──────────────────────────────────────────
META_GRAPH_VERSION=v21.0
# SP-14: Graph base URL override for the local verification stub. Only
# https://graph.facebook.com or http://127.0.0.1:<port> is honoured; anything
# else falls back to the default. Leave unset.
# META_GRAPH_BASE_URL=
META_VERIFY_TOKEN=aram-meta-verify-1f4a9c-local
META_APP_ID=local-app-id
META_APP_SECRET=local-app-secret
# Legacy separate WhatsApp app. Used for WhatsApp only while
# META_TECH_PROVIDER_ENABLED is off; afterwards kept as a fallback so webhooks
# and tokens from customers connected through it keep working.
META_APP_ID_WA=local-wa-app-id
META_APP_SECRET_WA=local-wa-app-secret
# Previous main Meta app secret, kept while pages connected through it are live.
META_APP_SECRET_LEGACY=
# Tech Provider popup connect. Leave "false" until Meta approves the app.
# See docs/meta-tech-provider-setup.md.
META_TECH_PROVIDER_ENABLED=false
META_FB_CONFIG_ID=            # Facebook Login for Business configuration id
# SP-19 WhatsApp Embedded Signup. The "Connect with Meta" button stays hidden
# (with a reason in the channels hub) until META_APP_ID_WA, META_APP_SECRET_WA
# and META_WA_CONFIG_ID are all set. Get the config id from the Meta app's
# "Facebook Login for Business" configuration for WhatsApp Embedded Signup
# (the app also needs Tech Provider access). Leave empty when unused.
META_WA_CONFIG_ID=
# Optional Multi-Partner Solution id shared with a Solution Partner.
META_WA_SOLUTION_ID=
# Optional: WhatsApp numbers per workspace for EVERY plan (positive integer).
# Empty uses the plan table: free 1, starter 1, growth 3, pro 10.
CHANNEL_WHATSAPP_LIMIT=
# AES-256-GCM key (32+ random chars) for stored channel tokens. Required in
# production for new channel secrets (embedded signup, Telegram, second
# numbers); without it dev stores them in plaintext with a warning.
TOKEN_ENC_KEY=
# SP-15 Meta Ads connect (Facebook Login for Business + Marketing API). The
# app id/secret fall back to META_APP_ID / META_APP_SECRET when one app serves
# both. The login config id comes from the app's Login for Business
# configuration (assets: Ad accounts, optionally Pages). Register
# ${BACKEND_PUBLIC_URL}/api/meta-ads/oauth/callback as a valid OAuth redirect
# URI. Production also needs TOKEN_ENC_KEY. Leave empty when unused.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_LOGIN_CONFIG_ID=
# Marketing API version (v<major>.<minor>); empty uses META_GRAPH_VERSION.
# Set a current version at deploy after checking Meta's changelog.
META_ADS_GRAPH_VERSION=
# Hourly spend sync knobs (empty = default): connections per tick (20), a
# connection is due after this many ms (3300000 = 55 min), a tick starts no
# new connection, and a running sync makes no new Graph read, after this
# many ms (600000 = 10 min); insights pages per 7-day window (40; a window
# that needs more is skipped and the run records "partial").
META_ADS_SYNC_BATCH=
META_ADS_SYNC_INTERVAL_MS=
META_ADS_SYNC_MAX_MS=
META_ADS_MAX_PAGES=
# SP-15 verification only: loopback stand-in for the fbcdn creative host
# (honoured only as http://127.0.0.1:<port>). Leave unset.
# META_CDN_TEST_BASE=

# ── Storage (local file storage) ───────────────────────────────────────────
# Uses local /uploads directory instead of DigitalOcean Spaces for development
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_ENDPOINT=

# ── Integrations (local) ───────────────────────────────────────────────────
JOTECK_CRM_SECRET=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:5174
# SP-26 outbound email (invitations; password reset in Task 2). EMAIL_PROVIDER is
# "resend" or "off" (default): with "off" the inviter gets a copy-link instead.
# APP_PUBLIC_URL above is the base of every emailed link. Verify the sending
# domain (SPF/DKIM) in Resend before turning it on. RESEND_API_BASE is only
# for a local stub (e.g. http://127.0.0.1:4249); leave empty in production.
EMAIL_PROVIDER=off
RESEND_API_BASE=
RESEND_API_KEY=
EMAIL_FROM=
ZERNIO_API_KEY=
ZERNIO_REDIRECT_BASE=http://localhost:5174
ZERNIO_WEBHOOK_SECRET=
# SP-14 number health. Zernio health calls take a shared campaign token, then
# one from this bucket (requests per minute, default 30).
ZERNIO_HEALTH_RPM=
# One live health check per number per this many ms (default 60000), and at
# most this many live checks per workspace per minute (default 10).
HEALTH_CHECK_COOLDOWN_MS=
HEALTH_CHECK_WS_PER_MIN=
# Webhook-triggered health checks per workspace per minute (default 30), separate from the live-check cap.
HEALTH_WEBHOOK_WS_PER_MIN=

# ── l (agent platform) webhook integration ────────────────────────────────
# Shared secret for inbound webhooks from l platform (x-l-secret header)
L_WEBHOOK_SECRET=

# Outbound secret this CRM sends as x-joteck-secret when calling l's service-
# to-service joteck admin surface (Knowledge/Tools/MCP management). NOT the
# same value as JOTECK_CRM_SECRET above — that one gates the opposite
# direction (Kewy console calling into this CRM's own /joteck surface).
L_JOTECK_SECRET=
# Base URL of the Kewy AI (l) platform; /api/v1/joteck is appended.
L_API_URL=                    # dev: http://localhost:8000
# Where Kewy AI reaches this CRM's MCP server (/api/mcp/v1 is appended).
# Falls back to BACKEND_PUBLIC_URL; required in production. On Fly all three
# are secrets on kewy-marketing-api.
CRM_MCP_PUBLIC_URL=           # dev: http://localhost:4100

# ─── Ads Assistant (ported from hjz-v2) ───
# ANTHROPIC_API_KEY (declared under "API Keys" above) is required for chat.
ANTHROPIC_API_URL=            # optional override
ADS_CHAT_MODEL=claude-sonnet-5
PIPEBOARD_TOKEN=              # shared Pipeboard MCP token (Meta ads data)
PIPEBOARD_MCP_URL=https://meta-ads.mcp.pipeboard.co/
ADS_PRICE_INPUT_PER_1M=2.00   # claude-sonnet-5 list price (code default 3.00 is stale)
ADS_PRICE_OUTPUT_PER_1M=10.00
ADS_PRICE_INPUT_PER_1M_HAIKU=1.00
ADS_PRICE_OUTPUT_PER_1M_HAIKU=5.00
ADS_MARGIN_MULTIPLIER=2.0
ADS_USD_TO_JOD=0.72
ADS_MIN_BALANCE_JOD=0.5
ADS_MIN_TOPUP_JOD=5
ADS_APPROVAL_AMOUNT_WARN=50
ADS_ACTION_TTL_MIN=15
ADS_PUBLIC_WEB_URL=           # web origin for Stripe redirects (dev: http://localhost:5174)
STRIPE_SECRET_KEY=            # dormant until set
STRIPE_WEBHOOK_SECRET=

# ─── Kewy AI agent (kewy-ai service) ───
KEWY_AI_URL=                  # dev: http://localhost:4200
KEWY_AI_WEBHOOK_SECRET=       # HMAC key for the inbound message bridge (ai-bridge.service.ts)
# Per-deployment admin key for the knowledge API. Reads and writes EVERY
# tenant, so it stays server-side — never expose it with a VITE_ prefix.
KEWY_AI_ADMIN_SECRET=         # must equal ADMIN_API_SECRET in kewy-ai

# ─── Kewy workspace federation / SSO ───
# PEM public key of the Kewy control panel's RS256 signing keypair. Kewy holds
# the private half; this half only VERIFIES, so a compromise of this service
# cannot mint tokens for hjz or any other product.
# The Kewy SSO receiver (POST /api/auth/sso/kewy) is inert until this is set,
# which is what lets it ship before Kewy does.
KEWY_SSO_PUBLIC_KEY=""
# Exact `iss` string to require on Kewy tokens, e.g. https://kewy-website.fly.dev
KEWY_ISSUER=""

# Tiremall embed: shared secret to verify one-time SSO tokens minted by the Tiremall backend.
TIREMALL_SSO_SECRET=
# Tiremall embed: secret used to sign/verify webhooks exchanged with Tiremall.
TIREMALL_WEBHOOK_SECRET=

# ─── Kewy identity store (machine-to-machine, /api/idp/v1) ───
# Kewy checks every product's logins. crm still issues its own JWT; only the
# password check (and the package) moves. See kewy-website/docs/identity-api.md.
# Base URL including /api/idp/v1, e.g. https://kewy.ai/api/idp/v1
KEWY_IDP_URL=                 # dev: http://localhost:3000/api/idp/v1
# Sent as x-kewy-idp-secret; must equal KEWY_IDP_SECRET_CRM in kewy-website.
KEWY_IDP_SECRET=
# Where POST /api/auth/login checks the password:
#   local              crm's own bcrypt hash (default). Every user/password
#                      write is mirrored to Kewy best-effort, and each local
#                      login lazily backfills the user.
#   kewy_with_fallback Kewy /authenticate; the local hash is used only when
#                      Kewy is unreachable (network error, timeout, 5xx) —
#                      never on a 401. Password writes must reach Kewy unless
#                      it is unreachable.
#   kewy               Kewy only; unreachable → 503. Password writes must
#                      reach Kewy.
# Run scripts/export-identities-to-kewy.ts (--dry-run first) before leaving local.
AUTH_SOURCE=local

# ── SP-16 smart audiences ─────────────────────────────────────────────────
# Per-statement timeout for audience counts, previews and member pages (ms).
# A timeout answers count: null / timedOut: true, never a 500.
# AUDIENCE_COUNT_TIMEOUT_MS=8000
# How long GET /segments serves a cached smart-audience count (ms).
# AUDIENCE_COUNT_TTL_MS=300000

# ── SP-10 catalog import ──────────────────────────────────────────────────
# AI extraction uses ANTHROPIC_API_KEY / ANTHROPIC_API_URL (above). The URL must
# be the Anthropic API or, for verification only, http://127.0.0.1:<port>/...
# Model for extraction (default claude-opus-5-5).
# CATALOG_IMPORT_MODEL=
# Verification only: website imports go to this local stub instead of the
# internet. Honoured only when it is exactly http://127.0.0.1:<port>.
# CATALOG_FETCH_TEST_BASE=
