# Local development environment for CRM with local PostgreSQL

# ── Database (existing local PostgreSQL on 5440) ────────────────────────────
DATABASE_URL="postgresql://aram:aram@localhost:5440/aram"

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4100
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ── JWT Secrets ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod

# ── HJZ SSO Bridge (disabled locally) ───────────────────────────────────────
AUTH_MODE=sso
HJZ_JWT_ACCESS_SECRET=
HJZ_WEBHOOK_SECRET=
HJZ_OUTBOUND_URL=http://127.0.0.1:3030/api/v1/webhooks/marketing/segments

# ── Public URLs (local) ────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:4100
BACKEND_PUBLIC_URL=http://localhost:4100
FRONTEND_PUBLIC_URL=http://localhost:5174

# ── API Keys (empty for local, can add if needed) ─────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
OPENAI_API_KEY=

# ── Meta / WhatsApp (local stubs) ──────────────────────────────────────────
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=aram-meta-verify-1f4a9c-local
META_APP_ID=local-app-id
META_APP_SECRET=local-app-secret
META_APP_ID_WA=local-wa-app-id
META_APP_SECRET_WA=local-wa-app-secret

# ── Storage (local file storage) ───────────────────────────────────────────
# Uses local /uploads directory instead of DigitalOcean Spaces for development
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_ENDPOINT=

# ── Integrations (local) ───────────────────────────────────────────────────
JOTECK_CRM_SECRET=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:5174
ZERNIO_API_KEY=
ZERNIO_REDIRECT_BASE=http://localhost:5174
ZERNIO_WEBHOOK_SECRET=

# ── l (agent platform) webhook integration ────────────────────────────────
# Shared secret for inbound webhooks from l platform (x-l-secret header)
L_WEBHOOK_SECRET=

# Outbound secret this CRM sends as x-joteck-secret when calling l's service-
# to-service joteck admin surface (Knowledge/Tools/MCP management). NOT the
# same value as JOTECK_CRM_SECRET above — that one gates the opposite
# direction (Kewy console calling into this CRM's own /joteck surface).
L_JOTECK_SECRET=

# ─── Ads Assistant (ported from hjz-v2) ───
# ANTHROPIC_API_KEY (declared under "API Keys" above) is required for chat.
ANTHROPIC_API_URL=            # optional override
ADS_CHAT_MODEL=claude-sonnet-5
PIPEBOARD_TOKEN=              # shared Pipeboard MCP token (Meta ads data)
PIPEBOARD_MCP_URL=https://meta-ads.mcp.pipeboard.co/
ADS_PRICE_INPUT_PER_1M=2.00   # claude-sonnet-5 list price (code default 3.00 is stale)
ADS_PRICE_OUTPUT_PER_1M=10.00
ADS_PRICE_INPUT_PER_1M_HAIKU=1.00
ADS_PRICE_OUTPUT_PER_1M_HAIKU=5.00
ADS_MARGIN_MULTIPLIER=2.0
ADS_USD_TO_JOD=0.72
ADS_MIN_BALANCE_JOD=0.5
ADS_MIN_TOPUP_JOD=5
ADS_APPROVAL_AMOUNT_WARN=50
ADS_ACTION_TTL_MIN=15
ADS_PUBLIC_WEB_URL=           # web origin for Stripe redirects (dev: http://localhost:5174)
STRIPE_SECRET_KEY=            # dormant until set
STRIPE_WEBHOOK_SECRET=

# ─── Kewy AI agent (kewy-ai service) ───
KEWY_AI_URL=                  # dev: http://localhost:4200
KEWY_AI_WEBHOOK_SECRET=       # HMAC key for the inbound message bridge (ai-bridge.service.ts)
# Per-deployment admin key for the knowledge API. Reads and writes EVERY
# tenant, so it stays server-side — never expose it with a VITE_ prefix.
KEWY_AI_ADMIN_SECRET=         # must equal ADMIN_API_SECRET in kewy-ai

# ─── Kewy workspace federation / SSO ───
# PEM public key of the Kewy control panel's RS256 signing keypair. Kewy holds
# the private half; this half only VERIFIES, so a compromise of this service
# cannot mint tokens for hjz or any other product.
# The Kewy SSO receiver (POST /api/auth/sso/kewy) is inert until this is set,
# which is what lets it ship before Kewy does.
KEWY_SSO_PUBLIC_KEY=""
# Exact `iss` string to require on Kewy tokens, e.g. https://kewy-website.fly.dev
KEWY_ISSUER=""
