# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (Neon Postgres + pgvector)
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Auth
JWT_SECRET=change-me-in-prod

# ── HJZ SSO bridge ─────────────────────────────────────────────────────────
# Set AUTH_MODE=sso to enable POST /api/auth/sso/exchange (hjz-v2 SSO callers).
# Leave as "standalone" (or unset) for the standard email/password login only.
AUTH_MODE=standalone
# Used to verify hjz-signed access tokens during SSO exchange. Must equal the
# hjz API's JWT_ACCESS_SECRET. Leave blank when AUTH_MODE=standalone.
HJZ_JWT_ACCESS_SECRET=
# Shared secret for hjz's outbound client-sync webhooks (header: x-marketing-secret).
# Must equal hjz's MARKETING_WEBHOOK_SECRET. Leave blank to refuse all inbound calls.
HJZ_WEBHOOK_SECRET=

# Meta / Facebook integration
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ─── Zernio integration ────────────────────────────────────────────────────
# Zernio (zernio.com) fronts FB/IG/WhatsApp/TikTok/Snapchat with its OWN
# reviewed platform apps, so customers connect via hosted OAuth — no Meta App
# Review and no Tester enrollment on our side. Auth is a single global API key.
ZERNIO_API_KEY=33b86c4af71e3bfe365f79b3eb90970d18da750dc92bec07dbd0bf7cd08bb867

# Secret shown when you create a webhook endpoint in Zernio (Settings → Webhooks).
# Verifies the X-Zernio-Signature HMAC on POST /api/webhooks/zernio.
ZERNIO_WEBHOOK_SECRET=
# API base; override only if Zernio changes it.
ZERNIO_BASE_URL=https://zernio.com/api/v1
# Frontend URL the hosted connect flow redirects back to after auth.
# Falls back to FRONTEND_PUBLIC_URL, then APP_PUBLIC_URL, then localhost:5174.
ZERNIO_REDIRECT_BASE=
# Snapchat is in beta at Zernio (connect returns 403 until released). Set to
# "true" only once Zernio enables Snapchat for your account.
ZERNIO_SNAPCHAT_ENABLED=false

# Listening / mentions
ANTHROPIC_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# OpenAI (AI replies + KB embeddings)
OPENAI_API_KEY=
OPENAI_REPLY_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
AI_REPLY_CONFIDENCE_THRESHOLD=0.75

# Public base URL that external services (Instagram Graph fetchers, etc.)
# can reach the backend at. For dev, run `ngrok http 3001` and paste the
# https URL here. Falls back to APP_BASE_URL, then localhost:3001.
PUBLIC_BASE_URL=

# Media storage — DigitalOcean Spaces (S3-compatible).
# Leave blank to use local disk under backend/uploads/<workspaceId>/.
# Setting ALL five vars enables Spaces; partial config falls back to local.
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Optional CDN endpoint (DO Spaces -> Settings -> CDN). When set, signed URLs
# are rewritten to go through the CDN host instead of the origin Space.
DO_SPACES_CDN_ENDPOINT=

# ─── JOTECK admin integration ─────────────────────────────────────────────
# Shared HMAC secret for the /api/joteck/* surface that the JOTECK admin
# console calls. Validate with `x-joteck-secret` header.
# Generate with: openssl rand -hex 32
JOTECK_CRM_SECRET=

# ── Outbound mirror to HJZ ─────────────────────────────────────────────────
# POSTed to when CRM-origin segments change. Inbound CRM→HJZ endpoint is
# /api/v1/webhooks/marketing/segments on the HJZ side.
HJZ_OUTBOUND_URL=
# HJZ_WEBHOOK_SECRET is already declared above — reuse the same value for
# outbound (HJZ verifies the same shared secret on both sides).
