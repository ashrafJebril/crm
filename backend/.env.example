# Local development environment for CRM with local PostgreSQL

# ── Database (existing local PostgreSQL on 5440) ────────────────────────────
DATABASE_URL="postgresql://aram:aram@localhost:5440/aram"

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4100
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ── JWT Secrets ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod

# ── HJZ SSO Bridge (disabled locally) ───────────────────────────────────────
AUTH_MODE=sso
HJZ_JWT_ACCESS_SECRET=
HJZ_WEBHOOK_SECRET=
HJZ_OUTBOUND_URL=http://127.0.0.1:3030/api/v1/webhooks/marketing/segments

# ── Public URLs (local) ────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:4100
BACKEND_PUBLIC_URL=http://localhost:4100
FRONTEND_PUBLIC_URL=http://localhost:5174

# ── API Keys (empty for local, can add if needed) ─────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
OPENAI_API_KEY=

# ── Meta / WhatsApp (local stubs) ──────────────────────────────────────────
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=aram-meta-verify-1f4a9c-local
META_APP_ID=local-app-id
META_APP_SECRET=local-app-secret
META_APP_ID_WA=local-wa-app-id
META_APP_SECRET_WA=local-wa-app-secret

# ── Storage (local file storage) ───────────────────────────────────────────
# Uses local /uploads directory instead of DigitalOcean Spaces for development
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_ENDPOINT=

# ── Integrations (local) ───────────────────────────────────────────────────
JOTECK_CRM_SECRET=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:5174
ZERNIO_API_KEY=
ZERNIO_REDIRECT_BASE=http://localhost:5174
ZERNIO_WEBHOOK_SECRET=

# ── l (agent platform) webhook integration ────────────────────────────────
# Shared secret for inbound webhooks from l platform (x-l-secret header)
L_WEBHOOK_SECRET=

# Outbound secret this CRM sends as x-joteck-secret when calling l's service-
# to-service joteck admin surface (Knowledge/Tools/MCP management). NOT the
# same value as JOTECK_CRM_SECRET above — that one gates the opposite
# direction (Kewy console calling into this CRM's own /joteck surface).
L_JOTECK_SECRET=
