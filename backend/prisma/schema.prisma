// tkana — Prisma schema (Postgres + pgvector)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Auth & users ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Nullable so SSO-provisioned users (mirrored from hjz via /auth/sso/exchange)
  // don't need a local password. Standalone signups still get a bcrypt hash here.
  password  String?  // bcrypt hash
  name      String
  role      String   @default("Agent") // Owner | Manager | Agent | Viewer
  initials  String
  color     String   // oklch hue as string e.g. "150"
  status    String   @default("offline") // online | away | offline
  twoFA     Boolean  @default(false)

  // tkana-internal super-admin flag. When true, the user can access the
  // /admin/* portal (cross-tenant operations: list workspaces, view stats,
  // impersonate). This is NOT a workspace role — it's a system-wide capability
  // held by tkana staff for SaaS operations support.
  isSuperAdmin Boolean @default(false)

  // HJZ SSO bridge — opaque hjz user id (`sub`). Set when this User row is
  // a mirror of an hjz user provisioned via POST /auth/sso/exchange. Unique
  // so the same hjz user upserts to the same row across logins.
  externalId String? @unique

  // Kewy workspace federation — the Kewy Account id this user mirrors. Set on
  // users provisioned or SSO-exchanged through the Kewy control panel.
  // Distinct from externalId above, which belongs to the hjz bridge.
  kewyAccountId String? @unique

  // Tiremall admin user id (SSO). Distinct from externalId/kewyAccountId on purpose.
  tiremallUserId String? @unique

  memberships WorkspaceMember[]
  uploadedMedia Media[] @relation("UserMediaUploads")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  ownedContacts Contact[] @relation("ContactOwner")
  assignedActivities Activity[] @relation("ActivityAssignee")
  notifications Notification[] @relation("UserNotifications")
  /// SP-15 back-relation.
  metaAdsConnections MetaAdsConnection[] @relation("MetaAdsConnectedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Core CRM entities ─────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  industry  String
  lifecycle String
  source    String
  value     String?
  lastSeen  String   // human-readable like "2m"
  tags      String   @default("[]") // JSON-encoded string array
  convs     Int      @default(0)

  // Identity link to an external platform user (FB PSID, IG user id, etc.).
  // Used by the FB integration to upsert a real Contact row for each
  // conversation participant.
  externalSource String? // "facebook" | "instagram" | "tiktok"
  externalId     String?

  // Link to the HJZ client when the workspace is connected to an HJZ tenant
  // (Workspace.externalTenantId). Separate from externalSource/externalId,
  // which a WhatsApp/FB/IG contact already uses for its channel identity.
  hjzClientId      String?
  // Last attempt to create this contact in HJZ — the sync sweep retries
  // failed pushes after a back-off instead of hammering HJZ every minute.
  hjzSyncAttemptAt DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceContacts", fields: [workspaceId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  appointments  Appointment[]
  tickets       Ticket[]
  notes         Note[]
  activities    Activity[]
  segmentMembers SegmentMember[]
  campaignRecipients CampaignRecipient[] @relation("ContactCampaignRecipients")
  /// SP-15 back-relation: Instant Form submissions matched to this contact.
  metaLeads MetaLead[] @relation("ContactMetaLeads")

  // Structured name (name stays the display name), email, owner, consent.
  firstName       String?
  lastName        String?
  email           String?
  marketingOptOut Boolean @default(false)
  notALead        Boolean @default(false)
  ownerId         String?
  owner           User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  fieldValues     CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, externalSource, externalId])
  @@unique([workspaceId, hjzClientId])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, ownerId])
  // SP-13: keyset paging of a campaign audience (WHERE workspaceId = ? AND id > ? ORDER BY id).
  @@index([workspaceId, id])
  // SP-16: created-date audience rules; also serves the contacts list's createdAt desc order.
  @@index([workspaceId, createdAt])
}

model CustomFieldDef {
  id          String    @id @default(cuid())
  workspaceId String
  entity      String    @default("contact")
  key         String
  label       String
  labelAr     String
  /// text | number | date | select | boolean
  type        String
  options     Json?
  order       Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace          @relation("WorkspaceCustomFieldDefs", fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, entity, key])
  @@index([workspaceId])
}

model CustomFieldValue {
  defId     String
  contactId String
  value     Json
  updatedAt DateTime @updatedAt

  def     CustomFieldDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([defId, contactId])
  @@index([contactId])
}

model Conversation {
  id         String   @id @default(cuid())
  contactId  String
  unread     Int      @default(0)
  pinned     Boolean  @default(false)
  lastAt     String
  lastFrom   String   // them | human
  preview    String
  channel    String   // whatsapp | instagram | facebook | webchat | l
  status     String   // human | closed | spam
  intent     String
  confidence Float
  escalated  Boolean  @default(false)

  /// Kewy AI — per-thread opt-in. OFF by default on purpose: enabling the AI
  /// for a workspace must never silently start answering existing threads.
  /// The same flag gates the workspace's l agent auto-reply when one is linked.
  aiEnabled  Boolean   @default(false)
  /// Set when a human sends into an AI-handled thread. The agent backs off
  /// while this is present so staff and the bot can't talk over each other;
  /// clearing it hands the thread back to the AI.
  aiPausedAt DateTime?

  /// Conversation resolution — judged by Kewy AI (l) once the thread has been
  /// quiet past the idle window (ConversationResolutionService). Kept apart
  /// from `status`, which stays a human decision: nothing reopens a closed
  /// thread, so the AI never closes one. Cleared when the customer writes again.
  /// resolutionStatus: "resolved" (genuine) | "closed" (ended unresolved) | "open" (still live).
  resolutionStatus     String?
  /// resolved | customer_requested | abandoned | no_response | spam | duplicate | transferred
  resolution           String?
  /// complaint | escalation | none — a complaint/escalation opens a Support ticket.
  resolutionIssue      String?
  resolutionConfidence Float?
  resolutionSentiment  String?
  resolutionSummary    String?
  /// SP-31: optional extras from the resolution verdict (string arrays).
  topics               Json?
  painPoints           Json?
  resolutionRationale  String?
  resolvedAt           DateTime?
  /// The sweep's claim + "judged up to here" marker: due again only once a
  /// message newer than this arrives (or a failed attempt is retried).
  resolutionCheckedAt  DateTime?
  resolutionAttempts   Int       @default(0)
  resolutionError      String?

  // Provider-side conversation id (currently Zernio's). Lets replies address
  // the provider conversation directly instead of re-listing every send.
  externalId String?
  // l (agent platform) conversation id — set for conversations originating from l
  lConversationId String?
  // l agent id — set for conversations created by an l agent
  lAgentId String?

  /// Conversation ownership — the agent responsible for the thread (null = unassigned).
  assigneeId      String?
  assignee        User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Optimistic-concurrency counter, bumped on every ownership/status change.
  version         Int       @default(0)
  escalateReason  String?
  statusChangedAt DateTime?
  labels          ConversationLabelLink[]

  workspaceId String
  workspace   Workspace @relation("WorkspaceConversations", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  /// SP-19: the Channel (number/account) this thread belongs to. Null for
  /// rows the backfill could not derive, pre-SP-19 webchat and `l`; readers
  /// fall back through ChannelResolver.effectiveChannel.
  channelId  String?
  channelRef Channel? @relation("ConversationChannel", fields: [channelId], references: [id], onDelete: SetNull)

  /// SP-15: the first ad that started this thread. Set once, never overwritten.
  adSourceId   String?
  adSource     AdSource?    @relation("ConversationAdSource", fields: [adSourceId], references: [id], onDelete: SetNull)
  adReferredAt DateTime?
  adReferrals  AdReferral[] @relation("ConversationAdReferrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([workspaceId])
  @@index([lConversationId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, channelId])
  @@index([workspaceId, adSourceId])
}

model ConversationLabel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// ink | info | ok | warn | bad | accent | human
  color       String
  createdAt   DateTime @default(now())

  workspace Workspace               @relation("WorkspaceConversationLabels", fields: [workspaceId], references: [id], onDelete: Cascade)
  links     ConversationLabelLink[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ConversationLabelLink {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  from           String   // them | ai | human
  t              String   // display time, e.g. "10:42"
  body           String
  agent          String?
  attach         String?

  // Meta's wamid (WhatsApp) / Graph mid (Messenger). Set on outbound so we can
  // match incoming delivery-status webhooks back to the right Message row.
  metaMessageId    String?
  deliveryStatus   String?   // sent | delivered | read | failed
  deliveryStatusAt DateTime?

  /// SP-31: the customer's latest emoji reaction to this message (one kept).
  reaction   String?
  reactionAt DateTime?

  workspaceId  String
  workspace    Workspace   @relation("WorkspaceMessages", fields: [workspaceId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// SP-15 back-relation: the ad touch this inbound message carried.
  adReferral AdReferral? @relation("MessageAdReferral")

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@index([workspaceId])
  @@index([metaMessageId])
}

model Appointment {
  id           String   @id @default(cuid())
  contactId    String
  staffId      String?  // FK to User.id
  service      String
  serviceAr    String
  startAt      DateTime
  durationMin  Int
  status       String   // confirmed | pending | completed | cancelled | no-show
  source       String   // human | self-booking
  note         String?
  noteAr       String?
  reminderSent Boolean  @default(false)

  // Mirror in HJZ when the workspace is connected (Workspace.externalTenantId).
  // Every change sets hjzSyncPending; HjzAppointmentSyncService pushes it and
  // a one-minute sweep retries. hjzSyncError is the last refusal, shown on
  // the booking (e.g. no HJZ service with this name).
  hjzAppointmentId String?
  hjzSyncPending   Boolean   @default(false)
  hjzSyncAttemptAt DateTime?
  hjzSyncError     String?

  // SP-31: when `status` last changed (set by a DB trigger, so every writer is
  // covered). Dates the thread's booking_status event; null until a change.
  statusChangedAt DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceAppointments", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([startAt])
  @@index([workspaceId])
  @@index([hjzSyncPending])
}

model Template {
  id       String @id @default(cuid())
  name     String
  lang     String // en | ar
  category String // TRANSACTIONAL | UTILITY | MARKETING | AUTHENTICATION
  /// approved | pending | rejected | submitted | failed | local | paused | disabled
  status   String
  /// SP-14: Meta template quality (GREEN | YELLOW | RED | NOT_RATED). Null = unknown.
  quality  String?
  uses     Int    @default(0)

  // Meta WhatsApp Cloud API template content (sent to /{wabaId}/message_templates).
  // body is the only required component; header/footer/buttons are optional.
  body          String? // supports {{1}}, {{2}} variable placeholders
  footer        String? // 60-char max per Meta
  headerType    String? // "text" | "image" | "video" | "document"
  headerContent String? // text content, or sample media handle/URL
  buttons       String? // JSON array: [{ type: "QUICK_REPLY"|"URL"|"PHONE_NUMBER", text, url?, phone_number? }]

  // Meta lifecycle metadata.
  metaTemplateId      String? // template id returned by Meta on submit
  metaRejectionReason String? // populated when Meta sets status=REJECTED
  submittedAt         DateTime?
  reviewedAt          DateTime?

  /// SP-13: the library file chosen as the media header sample (image/video/document).
  headerMediaId String?
  headerMedia   Media?  @relation("TemplateHeaderMedia", fields: [headerMediaId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation("WorkspaceTemplates", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([metaTemplateId])
}

// Managed tag catalog: metadata (color, identity) OVER the tag names stored
// on Contact.tags. Assignment truth stays the contact's name array, so every
// name-matching surface (Inbox editor, segment filters) works unchanged.
model Tag {
  id    String @id @default(cuid())
  name  String
  color String // hue string, same convention as Segment.color

  workspaceId String
  workspace   Workspace @relation("WorkspaceTags", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ─── Contact segments ─────────────────────────────────────────────────────
// A Segment is a named, saved filter spec over the Contact table. Used by the
// Contacts chip bar (preset views) and the Campaigns audience picker. The
// filter is stored as a JSON string so we can evolve the shape without
// migrations; the server-side executor in segments.service.ts is the contract.
model Segment {
  id              String  @id @default(cuid())
  name            String
  nameAr          String?
  color           String? // hue string like "150", optional accent
  filter          String  @default("{}") // JSON: SegmentFilter shape
  // ── Sync fields (HJZ-CRM-2026-06-26) ───────────────────────────────
  origin          String  @default("crm")
  externalId      String?
  externalRules   String?
  lastSyncedAt    DateTime?
  /// SP-16: the rule tree (AudienceRules, v 2). Null = legacy: read `filter` as one `and` group.
  rules           Json?
  /// SP-16: optimistic concurrency for the audience editor (PATCH sends it; 409 on mismatch).
  version         Int       @default(0)
  /// SP-16: cached member count of a smart audience. Raw-SQL written; never bumps updatedAt.
  memberCount     Int?
  /// SP-16: when memberCount was computed.
  countedAt       DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceSegments", fields: [workspaceId], references: [id], onDelete: Cascade)

  members SegmentMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, origin, externalId])
  @@index([workspaceId])
}

// Materialized membership for hjz-origin segments. We can't re-evaluate
// HJZ rules locally (they reference fields like loyalty_tier, sales_count
// that CRM doesn't have), so HJZ ships the resolved client list and we
// snapshot it here. For crm-origin segments this table is unused; member
// counts come from running the filter against Contact.
model SegmentMember {
  segmentId String
  contactId String
  addedAt   DateTime @default(now())

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
  @@index([contactId])
}

// ─── Sales / ticket pipelines ─────────────────────────────────────────────

model Pipeline {
  id        String  @id @default(cuid())
  key       String  // "retail" | "bulk" | …
  name      String
  nameAr    String
  isDefault Boolean @default(false)

  // SP-07 pipeline editor
  version              Int       @default(0) // optimistic-concurrency counter for draft saves
  archivedAt           DateTime?
  staleDays            Int?
  agentCanMove         Boolean   @default(true)
  assignsConversations Boolean   @default(false)
  kind                 String    @default("deals") // "deals" | "leads" | "support"

  workspaceId String
  workspace   Workspace @relation("WorkspacePipelines", fields: [workspaceId], references: [id], onDelete: Cascade)

  stages      TicketStage[]
  tickets     Ticket[]
  lostReasons LostReason[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model TicketStage {
  id         String  @id @default(cuid())
  pipelineId String
  key        String  // unique within a pipeline
  label      String
  labelAr    String
  color      String  // semantic key: "ink" | "info" | "ok" | "warn" | "bad" | "accent" | "human"
  order      Int
  groupKey   String  // visual column: "new" | "discovery" | "quoted" | "payment" | "fulfill" | "done"
  isTerminal Boolean @default(false)
  isWon      Boolean @default(false)
  slaMinutes Int?

  workspaceId String
  workspace   Workspace @relation("WorkspaceTicketStages", fields: [workspaceId], references: [id], onDelete: Cascade)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@unique([pipelineId, key])
  @@index([pipelineId])
  @@index([workspaceId])
}

model Ticket {
  id             String  @id @default(cuid())
  number         Int
  pipelineId     String
  stageId        String
  contactId      String
  conversationId String?
  ownerId        String?

  title       String
  description String?
  value       Float?
  currency    String  @default("SAR")

  lostReason   String? // label snapshot, survives edits/deletes of the LostReason row
  lostReasonId String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?
  enteredStageAt DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation("WorkspaceTickets", fields: [workspaceId], references: [id], onDelete: Cascade)

  pipeline   Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      TicketStage      @relation(fields: [stageId], references: [id])
  lostReasonRef LostReason?   @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities TicketActivity[]
  notes      Note[]
  followUps  Activity[]

  @@unique([pipelineId, number])
  @@index([contactId])
  @@index([stageId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([lostReasonId])
}

model LostReason {
  id         String    @id @default(cuid())
  pipelineId String
  label      String
  labelAr    String
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation("WorkspaceLostReasons", fields: [workspaceId], references: [id], onDelete: Cascade)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@index([pipelineId])
  @@index([workspaceId])
}

/// SP-31: per-workspace canned replies, inserted in the composer via /shortcut.
model SavedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  bodyAr    String?
  shortcut  String   // [a-z0-9_-]{1,32}, unique per workspace
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation("WorkspaceSavedReplies", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
  @@index([workspaceId])
}

model TicketActivity {
  id        String  @id @default(cuid())
  ticketId  String
  kind      String  // "created" | "stage_changed" | "owner_changed" | "value_changed" | "note" | "won" | "lost"
  note      String?
  fromStage String?
  toStage   String?
  byUserId  String?

  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation("WorkspaceTicketActivities", fields: [workspaceId], references: [id], onDelete: Cascade)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([workspaceId])
}

model Integration {
  id           String   @id @default(cuid())
  platform     String   // "facebook" | "instagram" | "tiktok" | "whatsapp" — one row per platform per workspace
  // Transport: "meta" = our own Meta app (per-integration token), "zernio" =
  // via the Zernio aggregator (auth is the global API key, so accessToken is
  // null). Defaults to "meta" for legacy rows.
  provider     String   @default("meta")
  pageId       String?  // FB Page id / IG Business Account id / WhatsApp phone_number_id
  pageName     String?  // human-friendly identifier
  accessToken  String?  // long-lived token (NOT the App Secret). Null for zernio-provider rows.
  scopes       String?  // CSV of granted scopes
  expiresAt    DateTime?
  lastFetchedAt DateTime?
  raw          String?  // JSON metadata blob from the platform

  workspaceId String
  workspace   Workspace @relation("WorkspaceIntegrations", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// SP-19: the Channel mirrored from this row (legacy credential link).
  channel Channel?

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  /// SP-19: inbound routing looks a legacy row up by its account id.
  @@index([pageId])
}

/// SP-19: one connected channel (a WhatsApp number, a page, a Telegram bot, a
/// website chat). The routing source of truth. Each legacy Integration row is
/// mirrored to exactly one Channel (integrationId), whose credentials stay on
/// the Integration. The partial unique index "Channel_one_default_per_kind"
/// (one isDefault per workspace + kind) lives only in the migration SQL.
model Channel {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation("WorkspaceChannels", fields: [workspaceId], references: [id], onDelete: Cascade)
  kind              String // whatsapp | telegram | webchat | facebook | instagram | tiktok (others stored verbatim)
  provider          String // zernio | meta | telegram | native (legacy Integration.provider copied verbatim)
  externalId        String? // zernio accountId | Meta phone_number_id | Telegram bot id | null for webchat
  displayName       String
  phoneNumber       String? // E.164 for WhatsApp, when known
  status            String       @default("active") // active | pending | needs_attention | disconnected | error
  statusReason      String?
  health            Json? // reserved for SP-14; SP-19 leaves it null
  isDefault         Boolean      @default(false)
  config            Json? // NON-secret settings only
  secretsEnc        String? // encryptSecret(JSON) of {accessToken?, botToken?, registrationPin?}; never in a DTO
  webhookSecretHash String? // sha256 hex of the Telegram secret_token
  integrationId     String?      @unique
  integration       Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  lastInboundAt     DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  /// SP-14: when the last health check finished (any field read). Raw-SQL written.
  healthCheckedAt   DateTime?
  /// SP-14: claim token + cooldown + sweep cursor for health checks. Raw-SQL written.
  healthAttemptedAt DateTime?

  conversations Conversation[] @relation("ConversationChannel")
  campaigns     Campaign[]     @relation("CampaignSenderChannel")
  campaignRecipients CampaignRecipient[] @relation("ChannelCampaignRecipients")
  campaignBroadcasts CampaignBroadcast[] @relation("ChannelCampaignBroadcasts")

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, kind])
  @@index([provider, externalId])
  @@index([kind, healthAttemptedAt])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  status      String   // draft | scheduled | running | completed | failed | cancelled (legacy: paused)
  audience    String
  recipients  Int      @default(0)
  sent        Int      @default(0)
  delivered   Int      @default(0)
  read        Int      @default(0)
  replied     Int      @default(0)
  conversions Int      @default(0)
  channel     String   // Broadcast | Drip | Trigger
  schedule    String?

  // Honest-draft bindings: the real segment + WhatsApp template the draft
  // will use. Plain ids (no FK) — the send engine arrives in Tier 2.
  segmentId  String?
  templateId String?

  // Sending happens as a Zernio WhatsApp broadcast (see CampaignSendService).
  zernioBroadcastId String?
  scheduledAt       DateTime?
  /// Value for each template placeholder {{1}}, {{2}}…: a contact field or a literal.
  variableMapping   Json?
  failed            Int       @default(0)
  /// Audience members left out at launch (no usable phone, opted out).
  skipped           Int       @default(0)
  lastError         String?
  launchedAt        DateTime?
  statsSyncedAt     DateTime?
  /// SP-19: the WhatsApp channel the broadcast goes out from; it must be an
  /// active Zernio WhatsApp channel. Null = the default WhatsApp channel.
  senderChannelId   String?
  senderChannel     Channel?  @relation("CampaignSenderChannel", fields: [senderChannelId], references: [id], onDelete: SetNull)
  /// SP-12: true once launch wrote one CampaignRecipient row per audience
  /// member. False on every campaign launched before SP-12 (aggregate only).
  recipientTracking  Boolean   @default(false)
  /// SP-12: last completed pull sweep of Zernio's per-recipient list.
  recipientsSyncedAt DateTime?
  /// SP-12: the pull sweep's resume offset (Zernio `skip`).
  recipientSyncSkip  Int       @default(0)
  /// SP-12 rows. Named recipientRows: `recipients` is already the Int count.
  recipientRows      CampaignRecipient[]

  /// SP-13: the sending numbers, in order; [0] is the primary (template copy,
  /// skipped rows). Empty = legacy: senderChannelId, else the default number.
  senderChannelIds  String[]  @default([])
  /// SP-13: {"1": {source, key?, value?, fallback?}, …}. Null on campaigns
  /// launched before SP-13 (they keep variableMapping).
  varMap            Json?
  /// SP-13: optional header file override (library media). Null = the template's sample.
  headerMediaId     String?
  headerMedia       Media?    @relation("CampaignHeaderMedia", fields: [headerMediaId], references: [id], onDelete: SetNull)
  /// SP-13 background launch.
  launchStage       String?   // planning | sending | done | failed
  launchHeartbeatAt DateTime?
  launchAttempts    Int       @default(0)
  launchedById      String?   // audit string, not a FK (survives the member leaving)
  planCompletedAt   DateTime?
  cancelRequestedAt DateTime?
  sendTransport     String?   // broadcast | direct
  broadcasts        CampaignBroadcast[]

  workspaceId String
  workspace   Workspace @relation("WorkspaceCampaigns", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status, launchHeartbeatAt])
}

/// SP-13: one Zernio broadcast (or one direct-send batch) of a campaign:
/// recipients sharing a sender and the same non-native variable values.
model CampaignBroadcast {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation("WorkspaceCampaignBroadcasts", fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channelId          String?
  channel            Channel?  @relation("ChannelCampaignBroadcasts", fields: [channelId], references: [id], onDelete: SetNull)
  /// Zernio account id at plan time (the channel may be renamed or re-pointed later).
  accountId          String
  /// sha256 hex of [channelId, ...non-native values]; unique per campaign.
  partitionKey       String
  /// Zernio variableMapping for this partition ({"1": {field|custom, customValue?}}).
  variables          Json
  transport          String    // broadcast | direct
  stage              String    @default("pending") // pending | contacts_imported | created | recipients_added | sent | scheduled | cancelled | failed
  recipientCount     Int       @default(0)
  importedThroughId  String?
  addedThroughId     String?
  createAttemptedAt  DateTime?
  zernioBroadcastId  String?
  recipientSyncSkip  Int       @default(0)
  recipientsSyncedAt DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  recipients         CampaignRecipient[]

  @@unique([campaignId, partitionKey])
  @@index([workspaceId])
  @@index([zernioBroadcastId])
  @@index([channelId])
}

/// SP-12: one row per audience member per campaign (reachable = queued,
/// left out = skipped). Status only moves forward; see
/// src/campaigns/tracking/recipient-status.ts.
model CampaignRecipient {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation("WorkspaceCampaignRecipients", fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Null once the contact is deleted; the row (and the campaign's history) stays.
  contactId      String?
  contact        Contact?  @relation("ContactCampaignRecipients", fields: [contactId], references: [id], onDelete: SetNull)
  /// The sending number. SP-13 splits a campaign over several.
  channelId      String?
  channel        Channel?  @relation("ChannelCampaignRecipients", fields: [channelId], references: [id], onDelete: SetNull)
  /// E.164 (normalizePhone). Null only on skipped rows with no usable number.
  phone          String?
  /// Snapshot at launch, for the table and export after a contact is renamed/deleted.
  contactName    String?
  status         String    @default("queued") // queued | sent | delivered | read | replied | failed | skipped
  /// Provider message id (Zernio's id or Meta's wamid, as the provider reports it).
  messageId      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  repliedAt      DateTime?
  replyText      String? // <= 1000 chars
  buttonPayload  String? // <= 256 chars
  /// The inbound Message.id that attributed the reply (deep link into the thread).
  replyMessageId String?
  /// Namespaced: "meta:<n>" | "skip:<reason>" | "provider:unknown". See failure-codes.ts.
  failureCode    String?
  /// Provider text (errorExplanation ?? error), one line, <= 300 chars. Never shown unless short.
  failureReason  String?
  /// SP-13: the partition (Zernio broadcast or direct batch) this row goes out in.
  broadcastId     String?
  broadcast       CampaignBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  /// SP-13: the resolved template values (string[]), on queued rows only.
  templateParams  Json?
  /// SP-13: direct transport only; set when the send was claimed.
  sendAttemptedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, status, id])
  @@index([campaignId, id])
  @@index([workspaceId, messageId])
  @@index([channelId, phone])
  @@index([contactId])
  @@index([broadcastId, status, id])
  @@index([campaignId, channelId, status])
}

// ─── Workflows ────────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("draft") // "draft" | "active"
  triggerType String   // "contact_created" | "message_received" | "ticket_created" | "ticket_stage_changed" | "schedule" | "webhook"
  triggerConfig Json   @default("{}")
  steps       Json     @default("{\"entry\": null, \"steps\": {}}")
  webhookSecret   String?
  lastScheduledAt DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceWorkflows", fields: [workspaceId], references: [id], onDelete: Cascade)

  runs WorkflowRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, triggerType, status])
}

model WorkflowRun {
  id            String   @id @default(cuid())
  status        String   // "running" | "waiting" | "completed" | "failed" | "cancelled"
  context       Json     @default("{}")
  stepsSnapshot Json     @default("{}")
  cursor        Json     @default("{\"stepId\": null}")
  result        Json     @default("{}")
  resumeAt      DateTime?
  isTest        Boolean  @default(false)
  error         String?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation("WorkspaceWorkflowRuns", fields: [workspaceId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workspaceId, workflowId, startedAt])
  @@index([status, resumeAt])
}

// ─── Notes ────────────────────────────────────────────────────────────────

model Note {
  id             String   @id @default(cuid())
  contactId      String
  // Opaque conversation id (may be a DB Conversation.id OR a Facebook
  // conversation id like "t_..."), so this is intentionally a plain string,
  // not a FK relation.
  conversationId String?
  // Optional link to a Ticket — set when the note was written from the
  // pipeline ticket panel. Notes without ticketId are contact-level.
  ticketId       String?
  body           String
  authorUserId   String?  // FK to User.id, nullable for system-generated notes
  // Threaded replies: a reply points at its parent note; deleting the parent
  // deletes the thread.
  parentId       String?
  // User ids @mentioned in the body (deduped, validated against membership).
  mentions       String[] @default([])

  workspaceId String
  workspace   Workspace @relation("WorkspaceNotes", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ticket  Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  parent  Note?   @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Note[]  @relation("NoteReplies")
  seenBy  NoteSeen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([conversationId])
  @@index([ticketId])
  @@index([workspaceId])
  @@index([parentId])
}

// Read receipts for notes. No workspaceId: reach it only through a
// workspace-verified Note.
model NoteSeen {
  noteId String
  userId String
  seenAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
}

// In-app notification for one member. `title` holds a stable message key and
// `body` JSON params, so the UI renders text in the reader's language.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  type        String // assignment | mention | activity_due | connector_needs_attention | knowledge_source_failed | campaign_finished | import_finished
  title       String
  body        String?
  recordKind  String? // contact | conversation | ticket | booking | campaign
  recordId    String?
  actorId     String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation("WorkspaceNotifications", fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
  @@index([workspaceId, userId, createdAt])
}

model NotificationPreference {
  workspaceId String
  userId      String
  type        String
  inApp       Boolean @default(true)
  sound       Boolean @default(true)

  workspace Workspace @relation("WorkspaceNotificationPreferences", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId, type])
}

// ─── Workspaces (tenants) ─────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Riyadh")
  lang      String   @default("ar") // "en" | "ar"
  plan      String   @default("free") // "free" | "starter" | "growth" | "pro"
  // When set, the workspace is suspended (e.g., unpaid invoice, policy violation).
  // Tenant-level enforcement of this flag is a follow-up; for now it's a marker
  // visible in the admin portal.
  suspendedAt DateTime?

  // Kewy billing: when payment first became due. NULL = paid up. Independent of
  // suspendedAt (admin suspension); locked once older than PAYMENT_GRACE_DAYS.
  paymentDueSince DateTime?

  // HJZ SSO bridge — set on Workspaces that mirror an hjz tenant so we can
  // resolve `hjz tid → tkana workspace` idempotently across SSO exchanges
  // and client-sync webhooks. Nullable so existing standalone workspaces
  // are untouched.
  externalTenantId String? @unique

  // Kewy workspace federation — the id of the Kewy Workspace (the customer's
  // organization in the Kewy control panel) that owns this workspace. Kewy
  // sends it at provision time and on SSO handoff, so either side can resolve
  // the other without a lookup service.
  //
  // DISTINCT FROM externalTenantId ABOVE ON PURPOSE. That one holds an *hjz*
  // tenant id for the hjz SSO bridge. Reusing it here would silently fuse hjz
  // tenants with Kewy workspaces. Do not "consolidate" these two fields.
  kewyWorkspaceId String? @unique

  // Tiremall tenant marker (SSO) — the one fixed Tiremall workspace. Distinct
  // from externalTenantId/kewyWorkspaceId on purpose; do not consolidate.
  tiremallTenantId String? @unique

  // JOTECK admin — module flag list ("inbox", "campaigns", …). NULL = all
  // modules enabled (backwards compatible). When set, route guards consult
  // this and 403 modules outside the list.
  enabledModules Json?

  // Zernio — the Zernio "profile" id this workspace maps to. A Zernio profile
  // groups a customer's connected social accounts; we create one per workspace
  // the first time we generate a Zernio connect link, and reuse it thereafter.
  // Per-workspace isolation rides on this id (auth is a single global API key).
  zernioProfileId String?

  // l (agent platform) workspace id — maps this CRM workspace to an l workspace
  // for bidirectional conversation sync. Set by admin configuration.
  lWorkspaceId String? @unique

  // The l webhook endpoint this workspace's replies are posted to, and the
  // plaintext secret l issued when that endpoint was created. l stores only a
  // bcrypt hash of the secret, so this is the only readable copy — losing it
  // means rotating on the l side, not re-reading it. Both NULL means replies
  // are not forwarded, which is the default for a workspace with no agent
  // platform behind it.
  lEndpointId     String?
  lEndpointSecret String?

  // The l agent slug this workspace's Kewy AI config screens operate on.
  // Resolved lazily via l's idempotent "ensure default agent" endpoint and
  // cached here so every tool/MCP-server bind call doesn't re-resolve it.
  lAgentSlug String?

  // Per-workspace credential for the inbound MCP server endpoint
  // (POST /api/mcp/v1). The l platform's agent authenticates as this
  // workspace using this token, registered via the existing McpServersTab
  // "Add server" flow. Only a bcrypt hash is stored — losing the plaintext
  // means generating a new one, same contract as lEndpointSecret above.
  // mcpTokenPrefix is plaintext and indexed so the auth guard can find the
  // owning workspace in one lookup before the (expensive) bcrypt compare.
  mcpTokenPrefix    String?   @unique
  mcpTokenHash      String?
  mcpTokenCreatedAt DateTime?

  // Kapso — the BSP customer id this workspace maps to for WhatsApp.
  //
  // Restored after being dropped in 20260811150000_remove_kapso. That removal
  // moved WhatsApp onto Zernio, but the number was never migrated: Kapso kept
  // delivering to POST /api/webhooks/kapso, which had become a 404, and every
  // inbound WhatsApp message was silently dropped for three days before anyone
  // noticed. WhatsApp runs on Kapso; Zernio keeps Facebook and Instagram.
  kapsoCustomerId String?

  members WorkspaceMember[]
  roles   Role[]            @relation("WorkspaceRoles")
  importJobs ImportJob[]        @relation("WorkspaceImportJobs")
  activities Activity[]         @relation("WorkspaceActivities")

  contacts          Contact[]          @relation("WorkspaceContacts")
  conversations     Conversation[]     @relation("WorkspaceConversations")
  conversationLabels ConversationLabel[] @relation("WorkspaceConversationLabels")
  customFieldDefs   CustomFieldDef[]   @relation("WorkspaceCustomFieldDefs")
  messages          Message[]          @relation("WorkspaceMessages")
  appointments      Appointment[]      @relation("WorkspaceAppointments")
  templates         Template[]         @relation("WorkspaceTemplates")
  segments          Segment[]          @relation("WorkspaceSegments")
  tags              Tag[]              @relation("WorkspaceTags")
  campaigns         Campaign[]         @relation("WorkspaceCampaigns")
  pipelines         Pipeline[]         @relation("WorkspacePipelines")
  ticketStages      TicketStage[]      @relation("WorkspaceTicketStages")
  lostReasons       LostReason[]       @relation("WorkspaceLostReasons")
  savedReplies      SavedReply[]       @relation("WorkspaceSavedReplies")
  tickets           Ticket[]           @relation("WorkspaceTickets")
  ticketActivities  TicketActivity[]   @relation("WorkspaceTicketActivities")
  integrations      Integration[]      @relation("WorkspaceIntegrations")
  channels          Channel[]          @relation("WorkspaceChannels")
  campaignRecipients CampaignRecipient[] @relation("WorkspaceCampaignRecipients")
  campaignBroadcasts CampaignBroadcast[] @relation("WorkspaceCampaignBroadcasts")
  notes             Note[]             @relation("WorkspaceNotes")
  notifications     Notification[]     @relation("WorkspaceNotifications")
  notificationPreferences NotificationPreference[] @relation("WorkspaceNotificationPreferences")
  media             Media[]            @relation("WorkspaceMedia")
  workflows         Workflow[]         @relation("WorkspaceWorkflows")
  workflowRuns      WorkflowRun[]      @relation("WorkspaceWorkflowRuns")

  adsChatSessions       AdsChatSession[]       @relation("WorkspaceAdsChatSessions")
  adsChatMessages       AdsChatMessage[]       @relation("WorkspaceAdsChatMessages")
  adsPendingActions     AdsPendingAction[]     @relation("WorkspaceAdsPendingActions")
  adsActionAudits       AdsActionAudit[]       @relation("WorkspaceAdsActionAudits")
  adsWallet             AdsWallet?             @relation("WorkspaceAdsWallet")
  adsWalletTransactions AdsWalletTransaction[] @relation("WorkspaceAdsWalletTransactions")

  /// SP-15: click-to-WhatsApp attribution and Meta Ads.
  adSources         AdSource[]         @relation("WorkspaceAdSources")
  adReferrals       AdReferral[]       @relation("WorkspaceAdReferrals")
  adSpendDaily      AdSpendDaily[]     @relation("WorkspaceAdSpendDaily")
  metaAdsConnection MetaAdsConnection? @relation("WorkspaceMetaAdsConnection")
  metaLeads         MetaLead[]         @relation("WorkspaceMetaLeads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  // Workspace-scoped role, separate from User.role (which is a system-level
  // legacy field). Values: "owner" | "admin" | "agent" | "viewer".
  role        String
  // SP-25: the member's Role. NULL falls back to the workspace's system role
  // whose key equals the legacy `role` string above (kept for deployed code).
  roleId      String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roleRef   Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@index([roleId])
}

// SP-25: a workspace role — a resource × action permission matrix plus a
// conversation visibility. System roles (key = owner|admin|agent|viewer) are
// seeded per workspace; custom roles have key = NULL.
model Role {
  id                     String   @id @default(cuid())
  workspaceId            String
  key                    String?  // owner | admin | agent | viewer for system roles; NULL for custom
  name                   String
  nameAr                 String
  isSystem               Boolean  @default(false)
  permissions            Json     // { [resource]: Action[] }
  conversationVisibility String   @default("all") // "all" | "assigned"
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace Workspace         @relation("WorkspaceRoles", fields: [workspaceId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, name])
}

// SP-03: a contacts/audience file import. The uploaded file lives in Media
// (fileMediaId, a plain reference like other media links). createdById is a plain
// string rather than a User relation: it is an audit reference only, and a job
// row must survive its creator being removed without an extra SetNull FK.
model ImportJob {
  id              String    @id @default(cuid())
  workspaceId     String
  createdById     String
  kind            String    // "contacts" | "audience"
  status          String    @default("uploaded") // uploaded | previewed | running | done | failed | cancelled
  fileMediaId     String
  fileName        String
  totalRows       Int
  processed       Int       @default(0)
  created         Int       @default(0)
  updated         Int       @default(0)
  skipped         Int       @default(0)
  failed          Int       @default(0)
  duplicateInFile Int       @default(0)
  errors          Json      @default("[]")
  mapping         Json?
  options         Json?
  heartbeatAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation("WorkspaceImportJobs", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, heartbeatAt])
}

// ─── Activities & follow-ups (SP-04) ─────────────────────────────────────
// kind: follow_up | call | meeting | task | note_log. Open = doneAt null.
// createdById is an audit string, not a FK (survives the creator leaving).
model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  title       String
  notes       String?
  dueAt       DateTime?
  doneAt      DateTime?
  outcome     String?
  notifiedAt  DateTime?
  assigneeId  String?
  contactId   String?
  ticketId    String?
  bookingId   String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation("WorkspaceActivities", fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ticket    Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  booking   Appointment? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, assigneeId, doneAt, dueAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, ticketId])
  @@index([doneAt, notifiedAt, dueAt])
}

// ─── Media library ────────────────────────────────────────────────────────

model Media {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation("WorkspaceMedia", fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName      String   // original filename, kept for display
  mimeType      String   // "image/jpeg" | "image/png" | "image/gif" | "image/webp" | ...
  sizeBytes     Int
  storedPath    String   // "local": path relative to backend/uploads.
                         // "spaces": object key inside the DO Spaces bucket.
  storageKind   String   @default("local") // "local" | "spaces"
  width         Int?     // for images
  height        Int?     // for images
  uploadedById  String?  // FK to User.id; nullable for system-generated assets
  uploadedBy    User?    @relation("UserMediaUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  publicToken          String?   @unique
  publicTokenExpiresAt DateTime?

  /// SP-13 back-relations: campaigns and templates using this file as their header.
  campaignHeaders Campaign[] @relation("CampaignHeaderMedia")
  templateHeaders Template[] @relation("TemplateHeaderMedia")
  /// SP-15 back-relation: ad creatives re-hosted into this file.
  adSources AdSource[] @relation("AdSourceMedia")

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([uploadedById])
}

// ─── Ads Assistant (ported from hjz-v2) ───────────────────────────────────
// Chat agent ("Salma") that analyzes Meta ad campaigns via Pipeboard MCP,
// with a JOD wallet (token-metered billing) and an approval-gated write path.

model AdsChatSession {
  id          String    @id @default(cuid())
  createdById String    // User.id of the member who owns this chat — sessions are per-user, not shared across the workspace (they carry spend paid from that user's wallet activity)
  title       String?
  deletedAt   DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsChatSessions", fields: [workspaceId], references: [id], onDelete: Cascade)

  messages AdsChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
}

model AdsChatMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   AdsChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String         // "USER" | "ASSISTANT"
  content   String         // full message text (Postgres TEXT)
  toolCallsJson Json?      // assistant turns: the agent's tool calls (audit trail)
  usageJson     Json?      // token usage for the turn — reconciliation source if the wallet debit fails

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsChatMessages", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, sessionId, createdAt])
  @@index([sessionId])
}

model AdsPendingAction {
  // id is SUPPLIED by the write gate (the action_id shown to the model and user) — no default on purpose.
  id                   String  @id
  createdById          String  // session owner who chatted with Salma
  sessionId            String?
  tool                 String  // Pipeboard tool name, e.g. "update_campaign"
  argsJson             Json    // EXACT args the execute path sends to Meta — never redacted (argsHash seals them)
  argsHash             String  // sha256 over canonical {tool,args,summary} — tamper check at approve time
  summary              String  // the exact human-readable text shown to the approver
  summaryIsPlaceholder Boolean @default(true) // true = no machine renderer for this tool → NOT approvable
  status               String  @default("PENDING") // PENDING | EXECUTING | EXECUTED | FAILED | REJECTED | EXPIRED
  approvedById         String?
  approvedAt           DateTime?
  executedAt           DateTime?
  resultJson           Json?   // provider response, PII-redacted copy (for idempotent replay)
  errorText            String?
  expiresAt            DateTime // lazy TTL — expired rows are refused at approve time, not swept

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsPendingActions", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([sessionId])
}

model AdsActionAudit {
  // APPEND-ONLY by code contract: one row per pending-action state transition.
  id                 String  @id @default(cuid())
  actionId           String
  event              String  // PROPOSED | APPROVED | EXECUTED | FAILED | REJECTED | EXPIRED
  actorId            String?
  tool               String
  sessionId          String?
  argsRedactedJson   Json?   // PROPOSED only — PII-redacted
  summary            String? // PROPOSED only
  resultRedactedJson Json?   // EXECUTED only — PII-redacted
  errorText          String? // FAILED only

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsActionAudits", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, actionId, createdAt])
  @@index([workspaceId, event, createdAt])
}

model AdsWallet {
  id          String  @id @default(cuid())
  // One wallet per workspace. Decimal(12,4) not (12,2): a typical question costs
  // ~0.035 JOD, so 2 dp would be a ~14% rounding error per charge.
  balanceJod  Decimal @default(0) @db.Decimal(12, 4)
  // DB-level backstop added in raw migration SQL (PSL can't express CHECK):
  //   CONSTRAINT "AdsWallet_balanceJod_non_negative" CHECK ("balanceJod" >= 0)

  workspaceId String    @unique
  workspace   Workspace @relation("WorkspaceAdsWallet", fields: [workspaceId], references: [id], onDelete: Cascade)

  transactions AdsWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdsWalletTransaction {
  id              String    @id @default(cuid())
  walletId        String
  // onDelete: Restrict — this is an append-only financial ledger; a wallet with
  // history must never cascade-delete its rows.
  wallet          AdsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type            String    // MONTHLY_GRANT | TOPUP | DEBIT | REFUND | ADJUST
  amountJod       Decimal   @db.Decimal(12, 4) // signed per type (DEBIT rows are negative)
  balanceAfterJod Decimal   @db.Decimal(12, 4)
  description     String?
  breakdownJson   Json?     // frozen charge computation — immutable source of truth
  costBasisUsd    Decimal?  @db.Decimal(24, 14) // indexed mirror of breakdownJson.usdCost
  costBasisJod    Decimal?  @db.Decimal(24, 14) // costBasisUsd × the frozen fx rate
  externalRef     String?   @unique // Stripe checkout session id — webhook idempotency key

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsWalletTransactions", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([walletId, createdAt])
}

// ─── Kewy SSO ─────────────────────────────────────────────────────────────

model SsoNonce {
  // Single-use guard for Kewy handoff tokens. The `jti` of every accepted
  // token is inserted here inside the exchange transaction; a unique-constraint
  // violation means the token is being replayed.
  //
  // Deliberately a table and not an in-memory set: this API runs multiple
  // instances on Fly, so a per-process cache would let a replay through on any
  // machine that had not seen the token.
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ─── SP-15: click-to-WhatsApp ad attribution and Meta Ads ──────────────────

/// SP-15: one ad (or boosted post) per workspace, from a referral or the spend sync.
model AdSource {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation("WorkspaceAdSources", fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId        String // Meta ad id (referral.source_id / insights ad_id)
  sourceType      String // "ad" | "post" (others verbatim)
  headline        String?
  body            String?
  mediaType       String? // "image" | "video"
  mediaUrl        String? // Meta's signed creative link as received (expires within days)
  mediaId         String? // our re-hosted copy (ruling 6)
  media           Media?    @relation("AdSourceMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  sourceUrl       String?
  welcomeText     String?
  adAccountId     String? // "act_…" once known (Zernio synced attribution or the spend sync)
  adName          String?
  adSetName       String?
  campaignName    String?
  namesFrom       String? // "zernio" | "meta_sync"; null = no names known
  firstReferredAt DateTime?
  lastReferredAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversations Conversation[] @relation("ConversationAdSource")
  referrals     AdReferral[]
  spend         AdSpendDaily[]
  leads         MetaLead[]

  @@unique([workspaceId, sourceType, sourceId])
  @@index([workspaceId, lastReferredAt])
  @@index([workspaceId, adAccountId])
}

/// SP-15: one referral-bearing inbound message (a "conversation started" touch).
model AdReferral {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation("WorkspaceAdReferrals", fields: [workspaceId], references: [id], onDelete: Cascade)
  adSourceId     String
  adSource       AdSource     @relation(fields: [adSourceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation("ConversationAdReferrals", fields: [conversationId], references: [id], onDelete: Cascade)
  contactId      String
  channelId      String?
  messageId      String       @unique // our Message.id; redelivery-safe
  message        Message      @relation("MessageAdReferral", fields: [messageId], references: [id], onDelete: Cascade)
  provider       String // "zernio" | "meta"
  ctwaClid       String? // null when Meta omits it (WhatsApp Status placements)
  firstTouch     Boolean      @default(false)
  referredAt     DateTime

  @@index([workspaceId, adSourceId, referredAt])
  @@index([workspaceId, referredAt])
  @@index([conversationId])
}

/// SP-15: Meta-reported spend per ad per account-local day.
model AdSpendDaily {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation("WorkspaceAdSpendDaily", fields: [workspaceId], references: [id], onDelete: Cascade)
  adSourceId  String
  adSource    AdSource  @relation(fields: [adSourceId], references: [id], onDelete: Cascade)
  adAccountId String
  date        DateTime  @db.Date
  spend       Decimal   @db.Decimal(14, 4)
  currency    String // ISO 4217, the ad account's
  syncedAt    DateTime

  @@unique([adSourceId, date])
  @@index([workspaceId, adAccountId, date])
}

/// SP-15: one Meta Ads connection per workspace. Token columns never leave the backend.
model MetaAdsConnection {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  workspace         Workspace @relation("WorkspaceMetaAdsConnection", fields: [workspaceId], references: [id], onDelete: Cascade)
  status            String    @default("pending") // pending | active | needs_reconnect | disconnected
  statusReason      String? // key: token_refused | account_refused | …
  tokenEnc          String? // encryptSecret(token); roadmap name
  tokenExpiresAt    DateTime? // null = non-expiring (system-user token)
  pendingTokenEnc   String?
  pendingExpiresAt  DateTime?
  scopes            String? // CSV of granted permissions (from debug/permissions read)
  adAccountId       String? // "act_…"; roadmap name
  adAccountName     String?
  currency          String?
  timezone          String? // IANA, from timezone_name
  pageId            String? // roadmap name
  pageName          String?
  connectedById     String?
  connectedBy       User?     @relation("MetaAdsConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt       DateTime?
  lastSyncedAt      DateTime?
  lastSyncError     String? // key only
  syncAttemptedAt   DateTime? // claim token + cadence (raw SQL)
  spendBackfilledAt DateTime?
  checkAttemptedAt  DateTime? // check cooldown (raw SQL)
  leadCheckpoints   Json? // {formId: ISO created_time}
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, syncAttemptedAt])
}

/// SP-15: one Instant Form submission (ruling 9).
model MetaLead {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation("WorkspaceMetaLeads", fields: [workspaceId], references: [id], onDelete: Cascade)
  leadgenId   String
  formId      String
  formName    String?
  pageId      String
  adId        String?
  adSourceId  String?
  adSource    AdSource? @relation(fields: [adSourceId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?  @relation("ContactMetaLeads", fields: [contactId], references: [id], onDelete: Cascade)
  fieldData   Json // [{name, values: string[]}] verbatim
  createdTime DateTime // Meta's created_time
  importedAt  DateTime  @default(now())

  @@unique([workspaceId, leadgenId])
  @@index([workspaceId, contactId])
}
