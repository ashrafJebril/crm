// tkana — Prisma schema (Postgres + pgvector)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Auth & users ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Nullable so SSO-provisioned users (mirrored from hjz via /auth/sso/exchange)
  // don't need a local password. Standalone signups still get a bcrypt hash here.
  password  String?  // bcrypt hash
  name      String
  role      String   @default("Agent") // Owner | Manager | Agent | Viewer
  initials  String
  color     String   // oklch hue as string e.g. "150"
  status    String   @default("offline") // online | away | offline
  twoFA     Boolean  @default(false)

  // tkana-internal super-admin flag. When true, the user can access the
  // /admin/* portal (cross-tenant operations: list workspaces, view stats,
  // impersonate). This is NOT a workspace role — it's a system-wide capability
  // held by tkana staff for SaaS operations support.
  isSuperAdmin Boolean @default(false)

  // HJZ SSO bridge — opaque hjz user id (`sub`). Set when this User row is
  // a mirror of an hjz user provisioned via POST /auth/sso/exchange. Unique
  // so the same hjz user upserts to the same row across logins.
  externalId String? @unique

  // Kewy workspace federation — the Kewy Account id this user mirrors. Set on
  // users provisioned or SSO-exchanged through the Kewy control panel.
  // Distinct from externalId above, which belongs to the hjz bridge.
  kewyAccountId String? @unique

  memberships WorkspaceMember[]
  uploadedMedia Media[] @relation("UserMediaUploads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Core CRM entities ─────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  industry  String
  lifecycle String
  source    String
  value     String?
  lastSeen  String   // human-readable like "2m"
  tags      String   @default("[]") // JSON-encoded string array
  convs     Int      @default(0)

  // Identity link to an external platform user (FB PSID, IG user id, etc.).
  // Used by the FB integration to upsert a real Contact row for each
  // conversation participant.
  externalSource String? // "facebook" | "instagram" | "tiktok"
  externalId     String?

  workspaceId String
  workspace   Workspace @relation("WorkspaceContacts", fields: [workspaceId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  appointments  Appointment[]
  tickets       Ticket[]
  notes         Note[]
  segmentMembers SegmentMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, externalSource, externalId])
  @@index([workspaceId])
  @@index([workspaceId, email])
}

model Conversation {
  id         String   @id @default(cuid())
  contactId  String
  unread     Int      @default(0)
  pinned     Boolean  @default(false)
  lastAt     String
  lastFrom   String   // them | human
  preview    String
  channel    String   // whatsapp | instagram | facebook | webchat
  status     String   // human | closed | spam
  intent     String
  confidence Float
  escalated  Boolean  @default(false)

  /// Kewy AI — per-thread opt-in. OFF by default on purpose: enabling the AI
  /// for a workspace must never silently start answering existing threads.
  aiEnabled  Boolean   @default(false)
  /// Set when a human sends into an AI-handled thread. The agent backs off
  /// while this is present so staff and the bot can't talk over each other;
  /// clearing it hands the thread back to the AI.
  aiPausedAt DateTime?

  // Provider-side conversation id (currently Zernio's). Lets replies address
  // the provider conversation directly instead of re-listing every send.
  externalId String?

  workspaceId String
  workspace   Workspace @relation("WorkspaceConversations", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([workspaceId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  from           String   // them | ai | human
  t              String   // display time, e.g. "10:42"
  body           String
  agent          String?
  attach         String?

  // Meta's wamid (WhatsApp) / Graph mid (Messenger). Set on outbound so we can
  // match incoming delivery-status webhooks back to the right Message row.
  metaMessageId    String?
  deliveryStatus   String?   // sent | delivered | read | failed
  deliveryStatusAt DateTime?

  workspaceId  String
  workspace    Workspace   @relation("WorkspaceMessages", fields: [workspaceId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([workspaceId])
  @@index([metaMessageId])
}

model Appointment {
  id           String   @id @default(cuid())
  contactId    String
  staffId      String?  // FK to User.id
  service      String
  serviceAr    String
  startAt      DateTime
  durationMin  Int
  status       String   // confirmed | pending | completed | cancelled | no-show
  source       String   // human | self-booking
  note         String?
  noteAr       String?
  reminderSent Boolean  @default(false)

  workspaceId String
  workspace   Workspace @relation("WorkspaceAppointments", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([startAt])
  @@index([workspaceId])
}

model Template {
  id       String @id @default(cuid())
  name     String
  lang     String // en | ar
  category String // TRANSACTIONAL | UTILITY | MARKETING | AUTHENTICATION
  status   String // approved | pending | rejected | submitted | failed
  uses     Int    @default(0)

  // Meta WhatsApp Cloud API template content (sent to /{wabaId}/message_templates).
  // body is the only required component; header/footer/buttons are optional.
  body          String? // supports {{1}}, {{2}} variable placeholders
  footer        String? // 60-char max per Meta
  headerType    String? // "text" | "image" | "video" | "document"
  headerContent String? // text content, or sample media handle/URL
  buttons       String? // JSON array: [{ type: "QUICK_REPLY"|"URL"|"PHONE_NUMBER", text, url?, phone_number? }]

  // Meta lifecycle metadata.
  metaTemplateId      String? // template id returned by Meta on submit
  metaRejectionReason String? // populated when Meta sets status=REJECTED
  submittedAt         DateTime?
  reviewedAt          DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceTemplates", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([metaTemplateId])
}

// Managed tag catalog: metadata (color, identity) OVER the tag names stored
// on Contact.tags. Assignment truth stays the contact's name array, so every
// name-matching surface (Inbox editor, segment filters) works unchanged.
model Tag {
  id    String @id @default(cuid())
  name  String
  color String // hue string, same convention as Segment.color

  workspaceId String
  workspace   Workspace @relation("WorkspaceTags", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ─── Contact segments ─────────────────────────────────────────────────────
// A Segment is a named, saved filter spec over the Contact table. Used by the
// Contacts chip bar (preset views) and the Campaigns audience picker. The
// filter is stored as a JSON string so we can evolve the shape without
// migrations; the server-side executor in segments.service.ts is the contract.
model Segment {
  id              String  @id @default(cuid())
  name            String
  nameAr          String?
  color           String? // hue string like "150", optional accent
  filter          String  @default("{}") // JSON: SegmentFilter shape
  // ── Sync fields (HJZ-CRM-2026-06-26) ───────────────────────────────
  origin          String  @default("crm")
  externalId      String?
  externalRules   String?
  lastSyncedAt    DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceSegments", fields: [workspaceId], references: [id], onDelete: Cascade)

  members SegmentMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, origin, externalId])
  @@index([workspaceId])
}

// Materialized membership for hjz-origin segments. We can't re-evaluate
// HJZ rules locally (they reference fields like loyalty_tier, sales_count
// that CRM doesn't have), so HJZ ships the resolved client list and we
// snapshot it here. For crm-origin segments this table is unused; member
// counts come from running the filter against Contact.
model SegmentMember {
  segmentId String
  contactId String
  addedAt   DateTime @default(now())

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
  @@index([contactId])
}

// ─── Sales / ticket pipelines ─────────────────────────────────────────────

model Pipeline {
  id        String  @id @default(cuid())
  key       String  // "retail" | "bulk" | …
  name      String
  nameAr    String
  isDefault Boolean @default(false)

  workspaceId String
  workspace   Workspace @relation("WorkspacePipelines", fields: [workspaceId], references: [id], onDelete: Cascade)

  stages   TicketStage[]
  tickets  Ticket[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model TicketStage {
  id         String  @id @default(cuid())
  pipelineId String
  key        String  // unique within a pipeline
  label      String
  labelAr    String
  color      String  // semantic key: "ink" | "info" | "ok" | "warn" | "bad" | "accent" | "human"
  order      Int
  groupKey   String  // visual column: "new" | "discovery" | "quoted" | "payment" | "fulfill" | "done"
  isTerminal Boolean @default(false)
  isWon      Boolean @default(false)
  slaMinutes Int?

  workspaceId String
  workspace   Workspace @relation("WorkspaceTicketStages", fields: [workspaceId], references: [id], onDelete: Cascade)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@unique([pipelineId, key])
  @@index([pipelineId])
  @@index([workspaceId])
}

model Ticket {
  id             String  @id @default(cuid())
  number         Int
  pipelineId     String
  stageId        String
  contactId      String
  conversationId String?
  ownerId        String?

  title       String
  description String?
  value       Float?
  currency    String  @default("SAR")

  lostReason String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?
  enteredStageAt DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation("WorkspaceTickets", fields: [workspaceId], references: [id], onDelete: Cascade)

  pipeline   Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      TicketStage      @relation(fields: [stageId], references: [id])
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities TicketActivity[]
  notes      Note[]

  @@unique([pipelineId, number])
  @@index([contactId])
  @@index([stageId])
  @@index([ownerId])
  @@index([workspaceId])
}

model TicketActivity {
  id        String  @id @default(cuid())
  ticketId  String
  kind      String  // "created" | "stage_changed" | "owner_changed" | "value_changed" | "note" | "won" | "lost"
  note      String?
  fromStage String?
  toStage   String?
  byUserId  String?

  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation("WorkspaceTicketActivities", fields: [workspaceId], references: [id], onDelete: Cascade)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([workspaceId])
}

model Integration {
  id           String   @id @default(cuid())
  platform     String   // "facebook" | "instagram" | "tiktok" | "whatsapp" — one row per platform per workspace
  // Transport: "meta" = our own Meta app (per-integration token), "zernio" =
  // via the Zernio aggregator (auth is the global API key, so accessToken is
  // null). Defaults to "meta" for legacy rows.
  provider     String   @default("meta")
  pageId       String?  // FB Page id / IG Business Account id / WhatsApp phone_number_id
  pageName     String?  // human-friendly identifier
  accessToken  String?  // long-lived token (NOT the App Secret). Null for zernio-provider rows.
  scopes       String?  // CSV of granted scopes
  expiresAt    DateTime?
  lastFetchedAt DateTime?
  raw          String?  // JSON metadata blob from the platform

  workspaceId String
  workspace   Workspace @relation("WorkspaceIntegrations", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  status      String   // running | scheduled | draft | completed | paused
  audience    String
  recipients  Int      @default(0)
  sent        Int      @default(0)
  delivered   Int      @default(0)
  read        Int      @default(0)
  replied     Int      @default(0)
  conversions Int      @default(0)
  channel     String   // Broadcast | Drip | Trigger
  schedule    String?

  // Honest-draft bindings: the real segment + WhatsApp template the draft
  // will use. Plain ids (no FK) — the send engine arrives in Tier 2.
  segmentId  String?
  templateId String?

  workspaceId String
  workspace   Workspace @relation("WorkspaceCampaigns", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

// ─── Notes ────────────────────────────────────────────────────────────────

model Note {
  id             String   @id @default(cuid())
  contactId      String
  // Opaque conversation id (may be a DB Conversation.id OR a Facebook
  // conversation id like "t_..."), so this is intentionally a plain string,
  // not a FK relation.
  conversationId String?
  // Optional link to a Ticket — set when the note was written from the
  // pipeline ticket panel. Notes without ticketId are contact-level.
  ticketId       String?
  body           String
  authorUserId   String?  // FK to User.id, nullable for system-generated notes

  workspaceId String
  workspace   Workspace @relation("WorkspaceNotes", fields: [workspaceId], references: [id], onDelete: Cascade)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ticket  Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([conversationId])
  @@index([ticketId])
  @@index([workspaceId])
}

// ─── Workspaces (tenants) ─────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Riyadh")
  lang      String   @default("ar") // "en" | "ar"
  plan      String   @default("free") // "free" | "starter" | "growth" | "pro"
  // When set, the workspace is suspended (e.g., unpaid invoice, policy violation).
  // Tenant-level enforcement of this flag is a follow-up; for now it's a marker
  // visible in the admin portal.
  suspendedAt DateTime?

  // HJZ SSO bridge — set on Workspaces that mirror an hjz tenant so we can
  // resolve `hjz tid → tkana workspace` idempotently across SSO exchanges
  // and client-sync webhooks. Nullable so existing standalone workspaces
  // are untouched.
  externalTenantId String? @unique

  // Kewy workspace federation — the id of the Kewy Workspace (the customer's
  // organization in the Kewy control panel) that owns this workspace. Kewy
  // sends it at provision time and on SSO handoff, so either side can resolve
  // the other without a lookup service.
  //
  // DISTINCT FROM externalTenantId ABOVE ON PURPOSE. That one holds an *hjz*
  // tenant id for the hjz SSO bridge. Reusing it here would silently fuse hjz
  // tenants with Kewy workspaces. Do not "consolidate" these two fields.
  kewyWorkspaceId String? @unique

  // JOTECK admin — module flag list ("inbox", "campaigns", …). NULL = all
  // modules enabled (backwards compatible). When set, route guards consult
  // this and 403 modules outside the list.
  enabledModules Json?

  // Zernio — the Zernio "profile" id this workspace maps to. A Zernio profile
  // groups a customer's connected social accounts; we create one per workspace
  // the first time we generate a Zernio connect link, and reuse it thereafter.
  // Per-workspace isolation rides on this id (auth is a single global API key).
  zernioProfileId String?

  // Kapso — the BSP customer id this workspace maps to for WhatsApp.
  //
  // Restored after being dropped in 20260811150000_remove_kapso. That removal
  // moved WhatsApp onto Zernio, but the number was never migrated: Kapso kept
  // delivering to POST /api/webhooks/kapso, which had become a 404, and every
  // inbound WhatsApp message was silently dropped for three days before anyone
  // noticed. WhatsApp runs on Kapso; Zernio keeps Facebook and Instagram.
  kapsoCustomerId String?

  members WorkspaceMember[]

  contacts          Contact[]          @relation("WorkspaceContacts")
  conversations     Conversation[]     @relation("WorkspaceConversations")
  messages          Message[]          @relation("WorkspaceMessages")
  appointments      Appointment[]      @relation("WorkspaceAppointments")
  templates         Template[]         @relation("WorkspaceTemplates")
  segments          Segment[]          @relation("WorkspaceSegments")
  tags              Tag[]              @relation("WorkspaceTags")
  campaigns         Campaign[]         @relation("WorkspaceCampaigns")
  pipelines         Pipeline[]         @relation("WorkspacePipelines")
  ticketStages      TicketStage[]      @relation("WorkspaceTicketStages")
  tickets           Ticket[]           @relation("WorkspaceTickets")
  ticketActivities  TicketActivity[]   @relation("WorkspaceTicketActivities")
  integrations      Integration[]      @relation("WorkspaceIntegrations")
  notes             Note[]             @relation("WorkspaceNotes")
  media             Media[]            @relation("WorkspaceMedia")

  adsChatSessions       AdsChatSession[]       @relation("WorkspaceAdsChatSessions")
  adsChatMessages       AdsChatMessage[]       @relation("WorkspaceAdsChatMessages")
  adsPendingActions     AdsPendingAction[]     @relation("WorkspaceAdsPendingActions")
  adsActionAudits       AdsActionAudit[]       @relation("WorkspaceAdsActionAudits")
  adsWallet             AdsWallet?             @relation("WorkspaceAdsWallet")
  adsWalletTransactions AdsWalletTransaction[] @relation("WorkspaceAdsWalletTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  // Workspace-scoped role, separate from User.role (which is a system-level
  // legacy field). Values: "owner" | "admin" | "agent" | "viewer".
  role        String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── Media library ────────────────────────────────────────────────────────

model Media {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation("WorkspaceMedia", fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName      String   // original filename, kept for display
  mimeType      String   // "image/jpeg" | "image/png" | "image/gif" | "image/webp" | ...
  sizeBytes     Int
  storedPath    String   // "local": path relative to backend/uploads.
                         // "spaces": object key inside the DO Spaces bucket.
  storageKind   String   @default("local") // "local" | "spaces"
  width         Int?     // for images
  height        Int?     // for images
  uploadedById  String?  // FK to User.id; nullable for system-generated assets
  uploadedBy    User?    @relation("UserMediaUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  publicToken          String?   @unique
  publicTokenExpiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([uploadedById])
}

// ─── Ads Assistant (ported from hjz-v2) ───────────────────────────────────
// Chat agent ("Salma") that analyzes Meta ad campaigns via Pipeboard MCP,
// with a JOD wallet (token-metered billing) and an approval-gated write path.

model AdsChatSession {
  id          String    @id @default(cuid())
  createdById String    // User.id of the member who owns this chat — sessions are per-user, not shared across the workspace (they carry spend paid from that user's wallet activity)
  title       String?
  deletedAt   DateTime?

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsChatSessions", fields: [workspaceId], references: [id], onDelete: Cascade)

  messages AdsChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
}

model AdsChatMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   AdsChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String         // "USER" | "ASSISTANT"
  content   String         // full message text (Postgres TEXT)
  toolCallsJson Json?      // assistant turns: the agent's tool calls (audit trail)
  usageJson     Json?      // token usage for the turn — reconciliation source if the wallet debit fails

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsChatMessages", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, sessionId, createdAt])
  @@index([sessionId])
}

model AdsPendingAction {
  // id is SUPPLIED by the write gate (the action_id shown to the model and user) — no default on purpose.
  id                   String  @id
  createdById          String  // session owner who chatted with Salma
  sessionId            String?
  tool                 String  // Pipeboard tool name, e.g. "update_campaign"
  argsJson             Json    // EXACT args the execute path sends to Meta — never redacted (argsHash seals them)
  argsHash             String  // sha256 over canonical {tool,args,summary} — tamper check at approve time
  summary              String  // the exact human-readable text shown to the approver
  summaryIsPlaceholder Boolean @default(true) // true = no machine renderer for this tool → NOT approvable
  status               String  @default("PENDING") // PENDING | EXECUTING | EXECUTED | FAILED | REJECTED | EXPIRED
  approvedById         String?
  approvedAt           DateTime?
  executedAt           DateTime?
  resultJson           Json?   // provider response, PII-redacted copy (for idempotent replay)
  errorText            String?
  expiresAt            DateTime // lazy TTL — expired rows are refused at approve time, not swept

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsPendingActions", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([sessionId])
}

model AdsActionAudit {
  // APPEND-ONLY by code contract: one row per pending-action state transition.
  id                 String  @id @default(cuid())
  actionId           String
  event              String  // PROPOSED | APPROVED | EXECUTED | FAILED | REJECTED | EXPIRED
  actorId            String?
  tool               String
  sessionId          String?
  argsRedactedJson   Json?   // PROPOSED only — PII-redacted
  summary            String? // PROPOSED only
  resultRedactedJson Json?   // EXECUTED only — PII-redacted
  errorText          String? // FAILED only

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsActionAudits", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, actionId, createdAt])
  @@index([workspaceId, event, createdAt])
}

model AdsWallet {
  id          String  @id @default(cuid())
  // One wallet per workspace. Decimal(12,4) not (12,2): a typical question costs
  // ~0.035 JOD, so 2 dp would be a ~14% rounding error per charge.
  balanceJod  Decimal @default(0) @db.Decimal(12, 4)
  // DB-level backstop added in raw migration SQL (PSL can't express CHECK):
  //   CONSTRAINT "AdsWallet_balanceJod_non_negative" CHECK ("balanceJod" >= 0)

  workspaceId String    @unique
  workspace   Workspace @relation("WorkspaceAdsWallet", fields: [workspaceId], references: [id], onDelete: Cascade)

  transactions AdsWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdsWalletTransaction {
  id              String    @id @default(cuid())
  walletId        String
  // onDelete: Restrict — this is an append-only financial ledger; a wallet with
  // history must never cascade-delete its rows.
  wallet          AdsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type            String    // MONTHLY_GRANT | TOPUP | DEBIT | REFUND | ADJUST
  amountJod       Decimal   @db.Decimal(12, 4) // signed per type (DEBIT rows are negative)
  balanceAfterJod Decimal   @db.Decimal(12, 4)
  description     String?
  breakdownJson   Json?     // frozen charge computation — immutable source of truth
  costBasisUsd    Decimal?  @db.Decimal(24, 14) // indexed mirror of breakdownJson.usdCost
  costBasisJod    Decimal?  @db.Decimal(24, 14) // costBasisUsd × the frozen fx rate
  externalRef     String?   @unique // Stripe checkout session id — webhook idempotency key

  workspaceId String
  workspace   Workspace @relation("WorkspaceAdsWalletTransactions", fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([walletId, createdAt])
}

// ─── Kewy SSO ─────────────────────────────────────────────────────────────

model SsoNonce {
  // Single-use guard for Kewy handoff tokens. The `jti` of every accepted
  // token is inserted here inside the exchange transaction; a unique-constraint
  // violation means the token is being replayed.
  //
  // Deliberately a table and not an in-memory set: this API runs multiple
  // instances on Fly, so a per-process cache would let a replay through on any
  // machine that had not seen the token.
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}
