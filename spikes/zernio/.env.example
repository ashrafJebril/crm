# Zernio spike config — copy to .env and fill in. DO NOT commit .env.

# From zernio.com → Settings → API Keys (shown once).
ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The secret Zernio shows when you create a webhook endpoint (Settings → Webhooks).
ZERNIO_WEBHOOK_SECRET=

# Public HTTPS base that Zernio can reach (e.g. your ngrok/cloudflared tunnel).
# The listener serves the webhook at $ZERNIO_PUBLIC_URL/webhooks/zernio and the
# OAuth redirect at $ZERNIO_PUBLIC_URL/oauth/redirect.
ZERNIO_PUBLIC_URL=https://your-tunnel.example.dev

# Local port the listener binds to (tunnel forwards here).
PORT=4444

# Override only if Zernio changes the base path.
ZERNIO_BASE_URL=https://zernio.com/api/v1
