# Comma-separated origins allowed to embed this app in an iframe and message it
# (e.g. the Tiremall admin origin). Leave empty to disable embed messaging.
VITE_EMBED_PARENT_ORIGINS=

# Kewy billing page linked from the "workspace locked" screen. Leave empty to
# show the message without a link. Baked in at build time.
VITE_KEWY_BILLING_URL=
